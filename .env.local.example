# Bu faylni `.env.local` deb nusxalang va qiymatlarni toʻldiring:
#   cp .env.local.example .env.local

# ── Baza ──────────────────────────────────────────────────────────
# Neon Postgres connection string (neon.tech → loyiha → Connect → .env)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ── Better Auth ───────────────────────────────────────────────────
# Ixtiyoriy 64 belgili maxfiy satr: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=
# Prod'da: https://<loyiha>.vercel.app (docs/deploy.md ga qarang)
BETTER_AUTH_URL=http://localhost:3000

# ── Google OAuth (ixtiyoriy — qoʻyilsa "Google bilan kirish" yoqiladi) ──
# console.cloud.google.com → Credentials → OAuth client ID (Web).
# Redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ── Murabbiyona AI (ixtiyoriy — dars muharriridagi AI yordamchi) ──
# Kalitni https://console.anthropic.com/ dan oling.
ANTHROPIC_API_KEY=sk-ant-...
