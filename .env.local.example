# Bu faylni `.env.local` deb nusxalang va qiymatlarni toʻldiring:
#   cp .env.local.example .env.local

# ── Baza ──────────────────────────────────────────────────────────
# Neon Postgres connection string (neon.tech → loyiha → Connect → .env)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ── Better Auth ───────────────────────────────────────────────────
# Ixtiyoriy 64 belgili maxfiy satr: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=
# Prod'da: https://<loyiha>.vercel.app (docs/deploy.md ga qarang)
BETTER_AUTH_URL=http://localhost:3000

# ── Google OAuth (ixtiyoriy — qoʻyilsa "Google bilan kirish" yoqiladi) ──
# console.cloud.google.com → Credentials → OAuth client ID (Web).
# Redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ── Ustozona AI (dars muharriridagi AI yordamchi) ──
# Kamida bitta provayder kaliti kerak. Zanjir tartibi: AI_PROVIDER_CHAIN.
# Gemini (tekin, asosiy): https://aistudio.google.com → Get API key
GEMINI_API_KEY=
# Groq (tekin, fallback): https://console.groq.com → API Keys
GROQ_API_KEY=
# Gemini modeli (default: gemini-flash-latest — doim eng yangi Flash)
# GEMINI_MODEL=gemini-flash-latest
# Anthropic (premium, ixtiyoriy): https://console.anthropic.com/
# ANTHROPIC_API_KEY=sk-ant-...
# Provayder zanjiri (default: gemini,groq,anthropic — kaliti borlari sinaladi)
# AI_PROVIDER_CHAIN=gemini,groq
# Har foydalanuvchi uchun kunlik AI xabar limiti (default 30)
# AI_DAILY_LIMIT=30
# Har foydalanuvchi uchun kunlik hujjat (darslik/PDF) yuklash limiti (default 5)
# AI_DOC_DAILY_LIMIT=5

# ── Resend (parolni tiklash xatlari uchun — qoʻyilmasa, havola konsolga chiqadi) ──
# Kalitni https://resend.com/api-keys dan oling (bepul, kredit karta shart emas).
# RESEND_API_KEY=re_...
# RESEND_FROM_EMAIL=Ustozona <onboarding@resend.dev>
