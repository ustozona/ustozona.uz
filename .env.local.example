# Bu faylni `.env.local` deb nusxalang va qiymatlarni toʻldiring:
#   cp .env.local.example .env.local

# ── Baza ──────────────────────────────────────────────────────────
# Supabase Postgres — LessonLab bilan BITTA baza (loyiha: lxppxnawxmcfebmzdgil).
# Supabase → Connect → "Transaction pooler" (6543-port). 5432 EMAS:
# serverless toʻgʻridan-toʻgʻri ulanishda ulanish limitini tugatadi va
# bu bazani baham koʻrayotgan LessonLab botiga ham tegadi.
#
# `aws-1` prefiksi — pooler klasteri, har loyihada bir xil EMAS. Aniq
# satrni Supabase panelidan nusxalang; xato prefiks bilan
# "Tenant or user not found" chiqadi.
#
# Parolda `@ # / ? % &` boʻlsa URL-kodlang (masalan `#` → `%23`),
# aks holda satr notoʻgʻri boʻlinadi.
DATABASE_URL=postgresql://postgres.<ref>:<parol>@aws-1-eu-central-1.pooler.supabase.com:6543/postgres

# ── Supabase Storage (muharrir rasmlari) ──────────────────────────
# Qoʻyilmasa muharrir ISHLAYVERADI — rasm eski usulda, base64 sifatida
# hujjat ichiga tushadi (`src/server/actions/uploads.ts` dagi izohga
# qarang). Kalit qoʻyilsa rasm `editor-images` bucket'iga chiqadi va
# hujjatda faqat qisqa URL qoladi.
#
# SUPABASE_URL — Supabase → Project Settings → Data API → Project URL
# SUPABASE_SERVICE_ROLE_KEY — Project Settings → API Keys → `service_role`
#   ⛔ MAXFIY: RLS ni butunlay chetlab oʻtadi. Faqat serverda ishlatiladi,
#   hech qachon `NEXT_PUBLIC_` prefiksi bilan qoʻyilmaydi.
# SUPABASE_URL=https://<ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=

# ── Better Auth ───────────────────────────────────────────────────
# Ixtiyoriy 64 belgili maxfiy satr: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=
# Prod'da: https://<loyiha>.vercel.app (docs/deploy.md ga qarang)
BETTER_AUTH_URL=http://localhost:3000

# ── Google OAuth (ixtiyoriy — qoʻyilsa "Google bilan kirish" yoqiladi) ──
# console.cloud.google.com → Credentials → OAuth client ID (Web).
# Redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ── Ustozona AI (dars muharriridagi AI yordamchi) ──
# Kamida bitta provayder kaliti kerak. Zanjir tartibi: AI_PROVIDER_CHAIN.
# Gemini (tekin, asosiy): https://aistudio.google.com → Get API key
GEMINI_API_KEY=
# Groq (tekin, fallback): https://console.groq.com → API Keys
GROQ_API_KEY=
# Gemini modeli (default: gemini-flash-latest — doim eng yangi Flash)
# GEMINI_MODEL=gemini-flash-latest
# Anthropic (premium, ixtiyoriy): https://console.anthropic.com/
# ANTHROPIC_API_KEY=sk-ant-...
# Provayder zanjiri (default: gemini,groq,anthropic — kaliti borlari sinaladi)
# AI_PROVIDER_CHAIN=gemini,groq
# Har foydalanuvchi uchun kunlik AI xabar limiti (default 30)
# AI_DAILY_LIMIT=30
# Har foydalanuvchi uchun kunlik hujjat (darslik/PDF) yuklash limiti (default 5)
# AI_DOC_DAILY_LIMIT=5

# ── Resend (parolni tiklash xatlari uchun — qoʻyilmasa, havola konsolga chiqadi) ──
# Kalitni https://resend.com/api-keys dan oling (bepul, kredit karta shart emas).
# RESEND_API_KEY=re_...
# RESEND_FROM_EMAIL=Ustozona <onboarding@resend.dev>

# ── LessonLab (Ustozona Baholash) — docs/baholash-integratsiya.md ──
# Qoʻyilmasa integratsiya OʻCHIQ qoladi: /baholash panel sababini ochiq
# aytadi, soxta tugma koʻrsatmaydi. Uy vazifasi baribir ishlaydi.
#
# Ikki bayroq ALOHIDA tekshiriladi:
#   imzo kalitlari  → qogʻoz test (varaq PDF, OMR skaner)
#   qobiq manzili   → jonli oʻyin (arqon, poyga)
# LESSONLAB_API_BASE=https://lessonlab.uz
# LESSONLAB_PARTNER_KEY=pk_live_...
# Imzo siri — hech qachon brauzerga chiqmaydi. LessonLab serverida
# master kalitdan hosil qilinadi (docs/baholash-integratsiya.md §5).
# LESSONLAB_PARTNER_SECRET=
# LESSONLAB_GAMES_BASE=https://lessonlab.uz/edugames
# `/api/play/*` ga kira oladigan domenlar (vergul bilan). BOʻSH BOʻLSA
# hech kim oʻtmaydi — yopiq holat xavfsiz standart, `*` ishlatilmaydi.
# PLAY_ALLOWED_ORIGINS=https://lessonlab.uz

# ── IndexNow (Yandex/Bing'ga nashr haqida darhol xabar berish) ──
# Qoʻyilmasa oʻchiq qoladi: maqolalar sitemap orqali baribir topiladi,
# faqat sekinroq. Google IndexNow'ni QOʻLLAMAYDI — unga taʼsiri yoʻq.
#
# Kalit sir emas: u /indexnow-key.txt orqali ochiq koʻrsatiladi, vazifasi
# domenga egalikni isbotlash. Talab: 8–128 ta belgi, faqat a-zA-Z0-9-
# Yaratish: node -e "console.log(crypto.randomUUID().replace(/-/g,''))"
# INDEXNOW_KEY=

# ── Google Search Console (ixtiyoriy) ──
# Faqat HTML-meta usuli tanlansa kerak. DNS orqali tasdiqlangan boʻlsa
# boʻsh qoldiring. Yandex tokeni kodda turadi (layout.tsx).
# GOOGLE_SITE_VERIFICATION=
